# =====================================================================
#  Product Catalog — environment settings
#  Copy to .env and fill in. Business details (name, logo, colours,
#  WhatsApp, currency…) are NOT set here — use /admin/settings.
# =====================================================================

# Internal app name (not shown to customers).
APP_NAME="Product Catalog"

# Use "production" and APP_DEBUG=false on the live site.
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate
APP_KEY=
INSTALL_SETUP_TOKEN=
# Comma-separated addresses or CIDRs of reverse proxies you operate.
TRUSTED_PROXIES=
# The full website address, with https:// and no trailing slash.
# Image links, the sitemap and social sharing previews use this.
APP_URL=https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (MySQL) -------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cache, queue (work on any shared hosting) ---------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over HTTPS (set false for local http).
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# --- Uploaded images ---------------------------------------------------
# Leave empty to use storage/app/public + "php artisan storage:link".
# On hosts that don't allow symlinks, point this at a "storage" folder
# inside the web root, e.g. /home/cpaneluser/public_html/storage
PUBLIC_DISK_ROOT=

# --- Email -------------------------------------------------------------
# Email sending is set up in Admin -> Settings -> Email (SMTP or the server's
# PHP mail), with a "Send test email" button. These values are only the fallback
# used when nothing is chosen there. MAIL_MAILER=log writes emails to
# storage/logs and delivers nothing.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Catalogue options -------------------------------------------------
CATALOG_PER_PAGE=12
CATALOG_MAX_UPLOAD_KB=10240
# Photo quality 60-100 (90 = visually lossless). Logos are always lossless.
CATALOG_IMAGE_QUALITY=90
